hostname DSW2
!
ip routing
!
interface Port-channel1
 description ## L2 PAgP Trunk Bundle to ASW2 ##
 switchport trunk encapsulation dot1q
 switchport mode trunk
!
interface Port-channel2
 description ## L3 Routed Bundle to DSW1 ##
 no switchport
 ip address 10.0.0.2 255.255.255.252
!
interface GigabitEthernet1/0/1
 description ## L3 Member to DSW1 ##
 no switchport
 no ip address
 channel-group 2 mode on
 no shutdown
!
interface GigabitEthernet1/0/2
 description ## L3 Member to DSW1 ##
 no switchport
 no ip address
 channel-group 2 mode on
 no shutdown
!
interface GigabitEthernet1/0/3
 description ## L2 Member to ASW2 ##
 switchport trunk encapsulation dot1q
 switchport mode trunk
 channel-protocol pagp
 channel-group 1 mode desirable
 no shutdown
!
interface GigabitEthernet1/0/4
 description ## L2 Member to ASW2 ##
 switchport trunk encapsulation dot1q
 switchport mode trunk
 channel-protocol pagp
 channel-group 1 mode desirable
 no shutdown
!
interface Vlan1
 ip address 172.16.2.254 255.255.255.0
 no shutdown
!
! Static route to ASW1's subnet via routed Port-Channel
ip route 172.16.1.0 255.255.255.0 10.0.0.1
!
end
