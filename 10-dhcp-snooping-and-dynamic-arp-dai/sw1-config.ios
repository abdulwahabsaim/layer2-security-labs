hostname SW1
!
! 1. Dynamic ARP Inspection (DAI) Enablement & Payload Validation
ip arp inspection vlan 1
ip arp inspection validate src-mac dst-mac ip
!
! 2. DHCP Snooping Global & VLAN Enablement
ip dhcp snooping vlan 1
no ip dhcp snooping information option
ip dhcp snooping
!
interface GigabitEthernet0/2
 description ## Uplink to Authorized Gateway (R1) - TRUSTED ##
 ip arp inspection trust
 ip dhcp snooping trust
 no shutdown
!
interface GigabitEthernet0/1
 description ## Downlink to SW2 - UNTRUSTED ##
 no shutdown
!
interface range FastEthernet0/1-24
 description ## Host Edge Access Ports - UNTRUSTED ##
!
end
