! ==============================================================================
! Device: Switch S1 (Backup Root Bridge)
! Role: Core Layer STP Secondary Root (Priority 8192) with Root Guard on Edge Ports
! Platform: Cisco Catalyst 3650-24PS (IOS-XE 16.3.2)
! ==============================================================================
version 16.3.2
service timestamps log datetime msec
service timestamps debug datetime msec
no service password-encryption
!
hostname S1
!
no ip domain-lookup
spanning-tree mode pvst
spanning-tree vlan 1 priority 8192
!
interface GigabitEthernet1/0/1
 description Trunk_to_S2_RootPort
!
interface GigabitEthernet1/0/2
 description Trunk_to_S3
!
interface range GigabitEthernet1/0/3 - 24
 description Access_Host_Ports_RootGuard_Protected
 spanning-tree guard root
!
interface Vlan1
 no ip address
 shutdown
!
line con 0
 logging synchronous
line aux 0
line vty 0 4
 login
!
end
