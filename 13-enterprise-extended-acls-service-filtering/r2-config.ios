hostname R2
!
interface GigabitEthernet0/0
 description ## Server Subnet 1 Gateway (SRV1 - DNS) ##
 ip address 192.168.1.254 255.255.255.0
 duplex auto
 speed auto
 no shutdown
!
interface GigabitEthernet0/1
 description ## Server Subnet 2 Gateway (SRV2 - Web) ##
 ip address 192.168.2.254 255.255.255.0
 duplex auto
 speed auto
 no shutdown
!
interface Serial0/0/0
 description ## WAN Point-to-Point Downlink to R1 ##
 ip address 203.0.113.2 255.255.255.252
 no shutdown
!
end
